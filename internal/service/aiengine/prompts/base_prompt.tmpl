</manual>

<examples>
<example type="positive" desc="标准单条件AST规则">
{"and": [{"field": "message", "operator": "contains", "value": "质量", "action": "row_inc"}]}
</example>

<example type="negative" desc="致命错误：最外层缺少 logic_node 逻辑节点包裹">
{"field": "message", "operator": "contains", "value": "质量"} 
</example>

<example type="positive" desc="复合条件多叉树AST规则">
{"and": [
  {"field": "age", "operator": "greater_than", "value": 60}, 
  {"or": [
    {"field": "status", "operator": "equals", "value": "active"},
    {"field": "is_vip", "operator": "equals", "value": true}
  ]}
]}
</example>
</examples>